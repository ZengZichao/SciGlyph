    "gallery:test": "node tools/reorg/gallery.test.mjs",
    "bilingual:check": "python3 tools/derive_en_variants.py --strict",
    "docs": "python3 tools/reorg/docs_gen.py"
  },
  "engines": {
    "node": ">=18"
  }
}
